<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>inkatlasgen</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Same local WolvenKit install as tools\archive; see that project for the reasoning. -->
  <PropertyGroup>
    <WolvenKitDir Condition="'$(WolvenKitDir)' == ''">$(USERPROFILE)\Documents\CP77_mods\WolvenKit-8.20.0\</WolvenKitDir>
  </PropertyGroup>

  <Target Name="CheckWolvenKit" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(WolvenKitDir)WolvenKit.RED4.dll')"
           Text="WolvenKit.RED4.dll not found under $(WolvenKitDir). Set the WolvenKitDir environment variable to your WolvenKit 8.20 install (the folder holding WolvenKit.RED4.dll)." />
  </Target>

  <ItemGroup>
    <Reference Include="WolvenKit.RED4"><HintPath>$(WolvenKitDir)WolvenKit.RED4.dll</HintPath></Reference>
    <Reference Include="WolvenKit.Core"><HintPath>$(WolvenKitDir)WolvenKit.Core.dll</HintPath></Reference>
    <Reference Include="WolvenKit.Common"><HintPath>$(WolvenKitDir)WolvenKit.Common.dll</HintPath></Reference>
    <Reference Include="System.Collections.Immutable"><HintPath>$(WolvenKitDir)System.Collections.Immutable.dll</HintPath></Reference>
    <Reference Include="System.Text.Json"><HintPath>$(WolvenKitDir)System.Text.Json.dll</HintPath></Reference>
    <Reference Include="System.Text.Encodings.Web"><HintPath>$(WolvenKitDir)System.Text.Encodings.Web.dll</HintPath></Reference>
  </ItemGroup>
</Project>
