# Livrables et espaces de travail locaux
dist/
packed/
.backup/
.projectFiles/

# Artefacts de compilation — le plugin C++ (plugin/build.ps1)
plugin/build/

# Artefacts de compilation — les outils .NET (tools/archive, tools/inkatlas)
tools/*/bin/
tools/*/obj/

# Python d'outillage
__pycache__/
*.pyc

# Prompts rendus par tools/prompt : reproductibles depuis fixtures/ + corpus.json
tools/prompt/out/

# Outillage d'agent et permissions locales
.claude/

# Le banc de synthese: les moteurs telecharges et les .wav produits. Des dizaines de Mo par
# voix, refabricables par fetch.ps1 -- rien de tout cela n'est une source.
tools/tts-lab/engines/
tools/tts-lab/out/

# Les voix extraites du jeu du joueur, et le dictionnaire de chemins qui sert a les
# trouver. Rien de tout cela n'est distribuable : c'est la copie du joueur.
tools/voice-extract/cache/
tools/voice-extract/src/bin/
tools/voice-extract/src/obj/

# Le moteur de parole. La copie amont se re-clone (build.ps1 -Fetch) et se patche
# (patch-runtime.py) : versionner la copie patchee ferait de `git checkout` un retour vers une
# source deja modifiee, et le patch a deux sources de verite.
vendor/PocketTTS.cpp/
vendor/pocket-deps/

# Les modeles ONNX exportes : 380 Mo par langue, refabricables par export-models.py.
models/

# Le decodeur des repliques du jeu, meme raison que ci-dessus : clone et fichier telecharges,
# patches par tools\pocket-engine\patch-decoder.py.
vendor/ww2ogg/
vendor/stb/
